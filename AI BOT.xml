                                <mutation xmlns="http://www.w3.org/1999/xhtml" items="2"></mutation>
                                <value name="ADD0">
                                  <block type="text" id="textTargetProfitMsg">
                                    <field name="TEXT">Target Profit Reached: Profit = </field>
                                  </block>
                                </value>
                                <value name="ADD1">
                                  <block type="variables_get" id="getCurrentProfitForTargetMsg">
                                    <field name="VAR" id="profit">Profit</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="controls_break" id="breakTargetProfit"></block>
                            </next>
                          </block>
                        </statement>
