                                    <value name="VALUE">
                                      <block type="api_response" id="apiResponseAfterWin"></block>
                                    </value>
                                    <next>
                                      <block type="procedures_callnoreturn" id="findLeastFrequentAfterWin">
                                        <mutation name="findLeastFrequentDigit"></mutation>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="math_change" id="profitChangeLoss">
            <field name="VAR" id="profit">Profit</field>
            <value name="DELTA">
              <block type="math_arithmetic" id="lossAmount">
                <field name="OP">MINUS</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
