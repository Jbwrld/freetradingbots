                              <block type="math_arithmetic" id="modTradesWin">
                                <field name="OP">MOD</field>
                                <value name="A">
                                  <block type="variables_get" id="getTradeCountForReanalysisWin">
                                    <field name="VAR" id="tradeCount">Trade Count</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="reanalysisIntervalWin">
                                    <field name="NUM">5</field>
                                  </block>
                                </value>
                              </block>
                            </value>
